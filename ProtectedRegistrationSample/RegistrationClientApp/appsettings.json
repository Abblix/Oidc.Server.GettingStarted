{
  "Provider": {
    // The provider's issuer identifier: the client reads its registration endpoint from the metadata published there
    "Issuer": "https://localhost:5011"
  },
  "Registration": {
    // The client_name the first registration carries, and the one the update replaces it with
    "ClientName": "Partner A reporting job",
    "UpdatedClientName": "Partner A nightly reporting job",

    // The client_name of the second registration, whose registration access token is tried on the first one
    "OtherClientName": "Partner A billing job"
  }
}
