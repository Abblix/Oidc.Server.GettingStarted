{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    // The address this provider is served on: its issuer identifier, written into every token it issues
    "Issuer": "https://localhost:5011",

    // The key, base64 of 32 random bytes, each issued client_secret is kept encrypted with, so a client reading its
    // registration gets its secret back. Published with the sample, so a development value only: a deployment
    // generates its own and keeps it out of this file, as the README shows.
    "ClientSecretEncryptionKey": "p1rYJhNQ64am7wwwGlkLkLMUpcVC4xLkmYFApqHyo9o="
  },
  "Operator": {
    // The SHA-256 hash, base64, of the key the operator presents to /operator. The key itself is not stored here,
    // so reading this file does not let anyone issue an initial access token. The sample's key is published in the
    // README, which makes this hash a development value only: generate your own key and hash as the README shows.
    "KeyHash": "fCrSD2RVmPQvUM1ycGD+Hd3XvhhKTSAw+Xi4mMFDYBw=",

    // The longest lifetime the operator may give an initial access token. A revocation is kept this long, which
    // is what makes it last as long as any token it could refuse.
    "MaxTokenLifetime": "1.00:00:00"
  }
}
