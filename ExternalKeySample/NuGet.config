<?xml version="1.0" encoding="utf-8"?>
<!-- Held-for-2.4 state: this sample references the Abblix.Oidc.Server.MinimalApi 2.4 dev build from the
     Abblix GitHub Packages feed, because 2.4 (which first carries the external-key crypto seam) is not on
     nuget.org yet. When 2.4 ships, bump the package to the released 2.4.0 and this file can go: the
     released package restores from nuget.org. The Azure.* packages already restore from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="github" value="https://nuget.pkg.github.com/Abblix/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Abblix.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
