{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    // The address this provider is served on: its issuer identifier, written into every token it issues
    "Issuer": "https://localhost:5007"
  },
  "McpServer": {
    // The MCP server's canonical URI: the resource MCP clients name in the resource parameter (RFC 8707),
    // and the audience of the access tokens issued for it. It must equal Mcp:Resource in McpServerApp.
    "Resource": "https://localhost:5008/mcp",
    // Reading the employee's tasks and changing them; they must equal Mcp:Scopes in McpServerApp
    "Scopes": {
      "Read": "tasks.read",
      "Write": "tasks.write"
    }
  },
  "ClientIdMetadataDocuments": {
    // The client identifier URLs whose metadata documents this provider fetches. Each prefix is an https URL ending
    // with a slash, compared character for character. McpClientApp serves its document under the first.
    "AllowedClientIdPrefixes": [ "https://localhost:5009/" ]
  }
}
