{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    // The address this provider is served on: its issuer identifier, written into every token it issues
    "Issuer": "https://localhost:5007",

    // The key, base64 of 32 random bytes, each issued client_secret is kept encrypted with, so a client reading its
    // registration gets its secret back. Published with the sample, so a development value only: a deployment
    // generates its own and keeps it out of this file, as the README shows.
    "ClientSecretEncryptionKey": "hhKA0XrQczXIqMsipH89+NGrYJkaITe5G9Do/FYedtE="
  },
  "Registration": {
    // How many clients one address may register within the window; more are answered 429 until it passes
    "PermitLimit": 10,
    "Window": "00:01:00"
  },
  "McpServer": {
    // The MCP server's canonical URI: the resource MCP clients name in the resource parameter (RFC 8707),
    // and the audience of the access tokens issued for it. It must equal Mcp:Resource in McpServerApp.
    "Resource": "https://localhost:5008/mcp",
    // Reading the employee's tasks and changing them; they must equal Mcp:Scopes in McpServerApp
    "Scopes": {
      "Read": "tasks.read",
      "Write": "tasks.write"
    }
  },
  "ClientIdMetadataDocuments": {
    // The client identifier URLs whose metadata documents this provider fetches, the vendors the company trusts. Each
    // prefix is an https URL ending with a slash, compared character for character. Without the list any document
    // is fetched, and the consent page is the user's only check. McpClientApp serves its document under the first.
    "AllowedClientIdPrefixes": [ "https://localhost:5009/" ]
  }
}
