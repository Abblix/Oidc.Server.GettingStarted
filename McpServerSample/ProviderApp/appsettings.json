{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provider": {
    // The address this provider is served on: its issuer identifier, written into every token it issues
    "Issuer": "https://localhost:5007",

    // The key, base64 of 32 random bytes, each issued client_secret is kept encrypted with, so a client reading its
    // registration gets its secret back. Published with the sample, so a development value only: a deployment
    // generates its own and keeps it out of this file, as the README shows.
    "ClientSecretEncryptionKey": "hhKA0XrQczXIqMsipH89+NGrYJkaITe5G9Do/FYedtE="
  },
  "McpServer": {
    // The MCP server's canonical URI: the resource MCP clients name in the resource parameter (RFC 8707),
    // and the audience of the access tokens issued for it. It must equal Mcp:Resource in McpServerApp.
    "Resource": "https://localhost:5008/mcp",
    "Scope": "mcp:tools"
  }
}
