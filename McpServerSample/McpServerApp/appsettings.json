{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    // This server's canonical URI: published as "resource" in the protected resource metadata (RFC 9728) and
    // required as the audience of every access token. It must equal McpServer:Resource in ProviderApp.
    "Resource": "https://localhost:5008/mcp",
    // The authorization server clients are sent to, and the only issuer whose tokens are accepted
    "AuthorizationServer": "https://localhost:5007",
    // Reading the user's tasks and changing them are separate scopes, so a user can grant one without the other
    "Scopes": {
      "Read": "tasks.read",
      "Write": "tasks.write"
    }
  },
  "Tracker": {
    // The tasks every user's list starts with, the first time the user is seen
    "SeedTasks": [ "Review the onboarding checklist", "Send the weekly status report", "Book the team offsite venue" ]
  }
}
