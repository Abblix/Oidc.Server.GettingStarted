{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      // The SDK logs a failed connection with its stack trace; the assistant reports it in one line instead
      "ModelContextProtocol.Client.McpClient": "None"
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    // The task tracker's MCP server; everything else the assistant learns from the server's challenge and metadata
    "Server": "https://localhost:5008/mcp"
  },
  "Demo": {
    // The task the assistant creates and then closes for the employee
    "NewTask": "Prepare the slides for Monday"
  },
  // Unset: the assistant asks for every scope the tracker names. Set to tasks.read alone (--Scopes:0 tasks.read) to
  // run an assistant the employee lets read the tasks but not change them.
  "Scopes": null,
  "Client": {
    // The assistant's metadata document. This app serves it at the URL its client_id names, and takes its name and
    // redirect URI from it in both registration modes, so the two cannot disagree.
    "MetadataDocument": "client-metadata.json",
    // How long the assistant waits for the employee to finish signing in before it gives up
    "SignInTimeout": "00:05:00"
  },
  // metadata-document: client_id is the URL of the document above, which the provider fetches.
  // dynamic: the client registers itself at the provider's registration endpoint (RFC 7591).
  // Chosen on the command line with --Registration dynamic.
  "Registration": "metadata-document",
  // browser: the authorization URL is printed for you to open, and the provider's redirect comes back to this app.
  // headless: this app signs in as the user below by posting the provider's login form itself.
  "SignIn": "browser",
  "HeadlessSignIn": {
    // The provider's demo user, from ProviderApp/Program.cs; read only with --SignIn headless
    "Email": "john.doe@example.com",
    "Password": "Jd!2024$3cur3"
  }
}
