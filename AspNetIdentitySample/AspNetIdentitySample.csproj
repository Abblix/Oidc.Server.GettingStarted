<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientAppRoot>ClientApp\</ClientAppRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ClientAppRoot)node_modules\**;$(ClientAppRoot)dist\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
	<PackageReference Include="Abblix.Oidc.Server.MinimalApi" Version="3.1.0-rc.803" />
	<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
	<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
	<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- The React auth SPA (SignIn/SignUp). Kept visible in the IDE but out of the .NET item graph. -->
  <ItemGroup>
    <Content Remove="$(ClientAppRoot)**" />
    <None Remove="$(ClientAppRoot)**" />
    <None Include="$(ClientAppRoot)**" Exclude="$(ClientAppRoot)node_modules\**;$(ClientAppRoot)dist\**" />
    <ClientAppInputs Include="$(ClientAppRoot)src\**\*;$(ClientAppRoot)index.html;$(ClientAppRoot)package.json;$(ClientAppRoot)package-lock.json;$(ClientAppRoot)vite.config.ts" />
  </ItemGroup>
  <!-- Restore npm packages whenever package-lock.json is newer than the copy npm keeps in node_modules: a fresh clone, or a pull that changed the lock. -->
  <Target Name="EnsureClientAppDeps" Inputs="$(ClientAppRoot)package-lock.json" Outputs="$(ClientAppRoot)node_modules\.package-lock.json">
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="NodeAppExitCode" />
    </Exec>
    <Error Condition="'$(NodeAppExitCode)' != '0'" Text="Node.js is required to build this project. Install it from https://nodejs.org/ and restart your terminal or IDE." />
    <!-- npm ci installs exactly what package-lock.json records and fails when package.json no longer matches
         it, so a version range never quietly pulls in a newer release. A compromised new release of any
         package, even one several levels down, would otherwise run its install scripts on the machine of
         everyone who builds this sample. -->
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm ci" />
  </Target>
  <!-- Bundle the React auth SPA into wwwroot/auth before every build. Incremental: skipped when the
       output is newer than the sources. -->
  <!-- SkipClientApp=true builds/runs the server alone (used once to bootstrap the OpenAPI schema the
       client generates its types from, before the client can build). -->
  <Target Name="BuildClientApp" BeforeTargets="Build" DependsOnTargets="EnsureClientAppDeps" Condition="'$(SkipClientApp)' != 'true'" Inputs="@(ClientAppInputs)" Outputs="wwwroot\auth\index.html">
    <Exec WorkingDirectory="$(ClientAppRoot)" Command="npm run build" />
  </Target>
</Project>
