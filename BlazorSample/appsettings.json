{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cookies": {
    "Cookie": {
      // Cookies do not separate by port, so a cookie of the default name would overwrite the provider's session
      // cookie on the same localhost. The __Host- prefix makes a browser accept the cookie only over HTTPS, with
      // Path=/ and no Domain, so a subdomain cannot plant or overwrite the session.
      "Name": "__Host-BlazorSample",
      "SecurePolicy": "Always",
      "HttpOnly": true,
      // Lax, not Strict: the browser returns from the provider's site, and the first request after that redirect
      // must carry the session the sign-in just created, which a Strict cookie is withheld from
      "SameSite": "Lax"
    }
  },
  "Authentication": {
    "DefaultScheme": "Cookies",
    "DefaultChallengeScheme": "OpenIdConnect",
    "SignOutScheme": "OpenIdConnect"
  },
  "OpenIdConnect": {
    "SignInScheme": "Cookies",
    "SignOutScheme": "Cookies",
    "SaveTokens": true,
    "Scope": [ "openid", "profile", "email" ],
    "MapInboundClaims": false,
    "ResponseType": "code",
    "ResponseMode": "query",
    "UsePkce": true,
    "GetClaimsFromUserInfoEndpoint": true
  }
}
