@page "/"

<PageTitle>Blazor OIDC client</PageTitle>

<h1>Blazor client for Abblix OIDC Server</h1>

<AuthorizeView>
    <Authorized>
        <p>Signed in as <strong>@context.User.Identity?.Name</strong>.</p>

        <h2>Claims</h2>
        <ul>
            @foreach (var claim in context.User.Claims)
            {
                <li>@claim.Type: @claim.Value</li>
            }
        </ul>

        @* data-enhance="false" makes this a real browser form post, so the redirect that
           clears the cookie is followed by the browser, not by enhanced form handling. *@
        <form method="post" action="/auth/logout" data-enhance="false">
            <AntiforgeryToken />
            <button type="submit">Sign out</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <p>You are not signed in.</p>
        <p><a href="/auth/login" data-enhance-nav="false">Sign in</a></p>
    </NotAuthorized>
</AuthorizeView>
