{
  "Authentication": {
    "DefaultScheme": "Cookies",
    "DefaultChallengeScheme": "OpenIdConnect"
  },
  "Cookies": {
    "Cookie": {
      "Name": "__Host-Bff",
      "SecurePolicy": "Always",
      "HttpOnly": true,
      "SameSite": "Strict"
    }
  },
  "OpenIdConnect": {
      "SignInScheme": "Cookies",
      "SignOutScheme": "Cookies",
      "SaveTokens": true,
      "Scope": ["openid", "profile", "email", "weather"],
      "MapInboundClaims": false,
      "ResponseType": "code",
      // form_post returns the authorization code in an auto-submitting POST to the backend,
      // so it never lands in the browser URL, history, or Referer the way "query" would.
      "ResponseMode": "form_post",
      "UsePkce": true,
      // The access token this client asks for names a resource (RFC 8707), so its audience is
      // the API rather than the provider - and the userinfo endpoint refuses a token minted for
      // somebody else, per RFC 9068 section 4. The claims come from the ID token instead, which
      // is what the profile and email scopes above fill in.
      "GetClaimsFromUserInfoEndpoint": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
