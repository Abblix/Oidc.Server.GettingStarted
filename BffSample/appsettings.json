{
  "Authentication": {
    "DefaultScheme": "Cookies",
    "DefaultChallengeScheme": "OpenIdConnect"
  },
  "Cookies": {
    "Cookie": {
      "Name": "__Host-Bff",
      "SecurePolicy": "Always",
      "HttpOnly": true,
      "SameSite": "Strict"
    }
  },
  "OpenIdConnect": {
      "SignInScheme": "Cookies",
      "SignOutScheme": "Cookies",
      "SaveTokens": true,
      "Scope": ["openid", "profile", "email", "weather"],
      "MapInboundClaims": false,
      "ResponseType": "code",
      // form_post returns the authorization code in an auto-submitting POST to the backend,
      // so it never lands in the browser URL, history, or Referer the way "query" would.
      "ResponseMode": "form_post",
      "UsePkce": true,
      "GetClaimsFromUserInfoEndpoint": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
