{
  "Authentication": {
    "DefaultScheme": "Cookies",
    "DefaultChallengeScheme": "OpenIdConnect"
  },
  "Cookies": {
    "Cookie": {
      // __Host-Http- (RFC 10017 section 6.1.3.2): a browser accepts the cookie only over HTTPS, from a response
      // rather than from script, with Path=/ and no Domain, so a subdomain cannot plant or overwrite it. The
      // chunks of a large cookie get the same prefix.
      "Name": "__Host-Http-Bff",
      "SecurePolicy": "Always",
      "HttpOnly": true,
      "SameSite": "Strict"
    },
    // Each request past the half of a session would otherwise renew it for another full span, so an active SPA
    // would keep a session alive long after the access token inside it expired (see UseTokenLifetime below)
    "SlidingExpiration": false
  },
  "OpenIdConnect": {
      "SignInScheme": "Cookies",
      "SignOutScheme": "Cookies",
      "SaveTokens": true,
      "Scope": ["openid", "profile", "email", "weather"],
      "MapInboundClaims": false,
      "ResponseType": "code",
      // form_post returns the authorization code in an auto-submitting POST to the backend,
      // so it never lands in the browser URL, history, or Referer the way "query" would.
      "ResponseMode": "form_post",
      "UsePkce": true,
      // The access token this client asks for names a resource (RFC 8707), so its audience is
      // the API rather than the provider - and the userinfo endpoint refuses a token minted for
      // somebody else, per RFC 9068 section 4. The claims come from the ID token instead, which
      // is what the profile and email scopes above fill in.
      "GetClaimsFromUserInfoEndpoint": false,
      // The session ends when the ID token does. This client gets no refresh token, so a session outliving the
      // access token it holds would answer every API call with 401; the provider's ID token expires before its
      // access token, and once the session is gone the SPA sends the user through the provider for a new one.
      "UseTokenLifetime": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Sent with every response: the published SPA runs only script and style from its own origin, connects only to
  // its own origin, and no other site may frame it
  "ContentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
}
