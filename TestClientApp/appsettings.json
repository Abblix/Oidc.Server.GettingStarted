{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Cookies do not separate by port, so a cookie of the default name would overwrite the provider's session
  // cookie on the same localhost
  "Cookies": {
    "Cookie": {
      "Name": ".TestClientApp"
    }
  },
  "Authentication": {
    "DefaultScheme": "Cookies",
    "DefaultChallengeScheme": "OpenIdConnect"
  },
  "OpenIdConnect": {
    "SignInScheme": "Cookies",
    "SignOutScheme": "Cookies",
    "SaveTokens": true,
    "Scope": [ "openid", "profile", "email", "weather" ],
    "MapInboundClaims": false,
    "ResponseType": "code",
    "ResponseMode": "query",
    "UsePkce": true,
    // The access token is minted for the API (the Resource setting), and the userinfo endpoint refuses a token
    // minted for somebody else, so the claims come from the ID token, which the profile and email scopes fill in
    "GetClaimsFromUserInfoEndpoint": false
  }
}
