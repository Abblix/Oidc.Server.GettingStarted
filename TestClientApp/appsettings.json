{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Where the provider posts a logout token when a session ends there (OpenID Connect Back-Channel Logout 1.0). The
  // provider registers the full address for this client, so the two have to name the same path.
  "BackChannelLogoutPath": "/signout-backchannel",
  "Cookies": {
    "Cookie": {
      // Cookies do not separate by port, so a cookie of the default name would overwrite the provider's session
      // cookie on the same localhost. The __Host- prefix makes a browser accept the cookie only over HTTPS, with
      // Path=/ and no Domain, so a subdomain cannot plant or overwrite the session.
      "Name": "__Host-TestClientApp",
      "SecurePolicy": "Always",
      "HttpOnly": true,
      // Lax, not Strict: the browser returns from the provider's site, and the first request after that redirect
      // must carry the session the sign-in just created, which a Strict cookie is withheld from
      "SameSite": "Lax"
    }
  },
  "Authentication": {
    "DefaultScheme": "Cookies",
    "DefaultChallengeScheme": "OpenIdConnect"
  },
  "OpenIdConnect": {
    "SignInScheme": "Cookies",
    "SignOutScheme": "Cookies",
    "SaveTokens": true,
    "Scope": [ "openid", "profile", "email", "weather" ],
    "MapInboundClaims": false,
    "ResponseType": "code",
    "ResponseMode": "query",
    "UsePkce": true,
    // The access token is minted for the API (the Resource setting), and the userinfo endpoint refuses a token
    // minted for somebody else, so the claims come from the ID token, which the profile and email scopes fill in
    "GetClaimsFromUserInfoEndpoint": false
  }
}
